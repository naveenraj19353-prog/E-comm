# MongoDB Atlas on Render — use mongodb+srv (not mongodb://localhost)
# 1. Atlas → Network Access → Allow 0.0.0.0/0 (required for Render)
# 2. URL-encode special characters in the password (@ → %40, etc.)
# MONGO_URI=mongodb+srv://user:password@cluster.jnun3bb.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.jnun3bb.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=Multi_Tenant_E_Comm
# Required — generate a long random string for production
SECRET_KEY=change-me-in-production
ALGORITHM=HS256

# Razorpay (use test keys in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional — forgot password)
EMAIL=
APP_PASSWORD=

# Comma-separated allowed browser origins
# Local: http://localhost:5173
# AWS Amplify: https://YOUR_APP.amplifyapp.com (update when API is on App Runner)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in password-reset emails
# Local: http://localhost:5173 | AWS: Amplify URL | Prod apex: https://retailcosmos.com
FRONTEND_URL=http://localhost:5173
ROOT_DOMAIN=retailcosmos.com
# auto/true: customer reset links use https://{slug}.retailcosmos.com when FRONTEND_URL is prod
# path/false: keep /{slug}/reset-password under FRONTEND_URL (Netlify beta)
TENANT_SUBDOMAIN_ROUTING=auto
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?retailcosmos\.com

# development | production
ENVIRONMENT=development

# First super admin bootstrap (run: python -m app.utils.create_first_super_admin)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# S3 product/banner image uploads
# Local: IAM user access key. EC2: prefer instance IAM role and leave keys empty.
S3_BUCKET=multi-tenant-ecomm-images-prod
S3_REGION=eu-north-1
# Optional local credentials only. On EC2 leave empty and use IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep true on EC2/production. Local Windows with SSL interception may need false.
S3_VERIFY_SSL=true
# Temporary image URL lifetime in seconds
S3_PRESIGNED_URL_EXPIRES=3600
