# MongoDB Atlas on Render — use mongodb+srv (not mongodb://localhost)
# 1. Atlas → Network Access → Allow 0.0.0.0/0 (required for Render)
# 2. URL-encode special characters in the password (@ → %40, etc.)
# MONGO_URI=mongodb+srv://user:password@cluster.jnun3bb.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.jnun3bb.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=Multi_Tenant_E_Comm
# Local Windows / Python 3.14 only — set 1 if Atlas TLS fails with CERTIFICATE_VERIFY_FAILED
MONGO_TLS_INSECURE=0
# Required — generate a long random string for production
SECRET_KEY=change-me-in-production
ALGORITHM=HS256

# Razorpay (use test keys in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Periskope WhatsApp (backend/EC2 only; never add these to client/Vite)
# Used for order notifications and store-create OTP.
PERISKOPE_API_KEY=
PERISKOPE_PHONE=
PERISKOPE_BASE_URL=https://api.periskope.app/v1
PERISKOPE_WEBHOOK_SIGNING_KEY=
PERISKOPE_TIMEOUT_SECONDS=10
# Keep true in production. Local Windows SSL interception may require false.
PERISKOPE_VERIFY_SSL=true

# Email — Gmail SMTP for forgot-password (not store signup OTP).
# Use the full Gmail address in EMAIL. APP_PASSWORD must be a 16-character
# Google App Password (not your normal Gmail password): Google Account →
# Security → 2-Step Verification → App passwords.
EMAIL=
APP_PASSWORD=

# Explicit browser origins (apex, www, local). Tenant subdomains are allowed by
# CORS_ORIGIN_REGEX in code — you do not need to list each store here.
CORS_ORIGINS=https://retailcosmos.com,https://www.retailcosmos.com,http://localhost:5173,http://127.0.0.1:5173
# Optional override. Must be a fully anchored regex (^...$). Leave unset to allow
# https://{tenant}.retailcosmos.com automatically from TENANT_BASE_DOMAIN.
# CORS_ORIGIN_REGEX=

# Frontend URL used in password-reset emails and customer notifications
# Local: http://localhost:5173 | Production: https://app.retailcosmos.com
FRONTEND_URL=http://localhost:5173
ROOT_DOMAIN=retailcosmos.com
# Tenant hosts: https://{slug}.retailcosmos.com (e.g. test21.retailcosmos.com)
TENANT_BASE_DOMAIN=retailcosmos.com
# auto/true uses tenant subdomains; path/false uses app.retailcosmos.com/{slug}/...
TENANT_SUBDOMAIN_ROUTING=auto
# development | production
ENVIRONMENT=development

# Which partner checkout/pincode uses first if the store has it connected.
# Partner API list lives in config/shipping_partners.json (not in the Vite client).
SHIPPING_PROVIDER=delhivery
SHIPPING_PARTNERS_FILE=

# Delhivery One (tenant API tokens are stored encrypted in Mongo — not here)
# Local: staging. Production API (ENVIRONMENT=production) defaults to live.
DELHIVERY_ENV=staging
DELHIVERY_STAGING_URL=https://staging-express.delhivery.com
DELHIVERY_LIVE_URL=https://track.delhivery.com
# Optional override; if empty, derived from DELHIVERY_ENV
DELHIVERY_BASE_URL=
# Automatic order status sync from Delhivery tracking (shipped / delivered /
# RTO flag). Minutes between runs across all API processes; 0 disables.
# One process at a time runs it (MongoDB lease in the job_locks collection).
SHIPMENT_SYNC_MINUTES=30
# Shipments tracked per run, oldest-checked first (Delhivery allows
# 750 tracking calls / 5 min / IP; the sync paces itself at ~2 per second).
SHIPMENT_SYNC_BATCH_SIZE=100
# Shared secret for POST /shipping/delhivery/webhook (Delhivery scan push).
# Give it to Delhivery as header "Authorization: Bearer <token>".
# Empty = the webhook rejects every request. Generate a long random value.
DELHIVERY_WEBHOOK_TOKEN=
# Optional; if empty, encryption key is derived from SECRET_KEY
TOKEN_ENCRYPTION_KEY=

# First super admin bootstrap (run: python -m app.utils.create_first_super_admin)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# S3 product/banner image uploads
# Local: IAM user access key. EC2: prefer instance IAM role and leave keys empty.
S3_BUCKET=multi-tenant-ecomm-images-prod
S3_REGION=eu-north-1
# Optional local credentials only. On EC2 leave empty and use IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep true on EC2/production. Local Windows with SSL interception may need false.
S3_VERIFY_SSL=true
# Temporary image URL lifetime in seconds
S3_PRESIGNED_URL_EXPIRES=3600
# Optional CDN in front of the private bucket (CloudFront + Origin Access Control),
# e.g. https://dxxxxxxxxxxxx.cloudfront.net or https://img.retailcosmos.com.
# When set, images are served as stable CDN_BASE_URL/tenants/... URLs instead of
# presigned S3 URLs. Leave empty to keep presigned URLs (reused per process).
CDN_BASE_URL=

# Seconds each server process caches public storefront data (store layout, home
# page, product lists/filters, categories). 0 disables. Writes clear the cache of
# the process that handled them; other processes catch up within this many seconds.
STOREFRONT_CACHE_SECONDS=60

# Public API origin used in docs / ops (OG endpoints live under /og/...)
# API_PUBLIC_URL=https://api.retailcosmos.com

# Rate limiting reads the client IP from X-Forwarded-For. Set this to the number
# of proxies in front of the API that append to that header. 0 uses the socket
# address; behind a proxy that makes every visitor share one IP.
# api.retailcosmos.com goes through Cloudflare, then Render/EC2's own front
# door, so that's 2 hops. If you ever remove Cloudflare (DNS-only / grey
# cloud), or if the app sees the request directly with no proxy, use 1 or 0.
# To check yourself: log request.headers.get("x-forwarded-for") once and
# count the comma-separated IPs before your server's own.
TRUSTED_PROXY_HOPS=2

# Platform commission on Razorpay-collected orders (a store's own negotiated
# rate, set by super admin, overrides this).
PLATFORM_DEFAULT_COMMISSION_PERCENT=5

# Store subscription billing. New stores get TRIAL_MONTHS free, then pay
# monthly via a Razorpay Subscription. Create the plan once in the Razorpay
# dashboard (Subscriptions -> Plans -> ₹499, monthly) and paste its plan_ id.
# Also add the subscription.* events to your existing Razorpay webhook
# (same URL: /payments/webhook, same RAZORPAY_WEBHOOK_SECRET).
# Leave the plan id empty to keep billing tracking on but subscribing disabled.
RAZORPAY_SUBSCRIPTION_PLAN_ID=
TRIAL_MONTHS=3
SUBSCRIPTION_GRACE_DAYS=7
# Display only — the charged amount always comes from the Razorpay plan.
SUBSCRIPTION_PRICE_INR=499

# Observability (app/observability). Everything below is optional.
# Logging: LOG_FORMAT=json in production (one JSON object per line), text locally.
# With json, run uvicorn with --no-access-log (the app writes its own access line).
LOG_FORMAT=text
LOG_LEVEL=INFO
# Sentry error tracking — leave SENTRY_DSN empty to disable completely.
SENTRY_DSN=
# Defaults to ENVIRONMENT when empty.
SENTRY_ENVIRONMENT=
# Share of requests traced for performance (0.0-1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional; falls back to RENDER_GIT_COMMIT / GIT_COMMIT when set by the host.
SENTRY_RELEASE=
# GET /metrics (Prometheus text) needs "Authorization: Bearer <METRICS_TOKEN>".
# Empty = endpoint returns 404. Each server process reports only its own numbers.
METRICS_TOKEN=
# Distinct stores given their own metrics label per process; the rest are "other".
METRICS_MAX_TENANTS=100
