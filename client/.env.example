# Server-only proxy target (not exposed in the browser bundle).
# Used when VITE_API_URL is unset and the app calls relative /api.
API_PROXY_TARGET=http://127.0.0.1:8000

# Browser API base URL (read by src/constants/api.ts as VITE_API_URL).
# Local + proxy: leave unset so API_BASE_URL stays "/api"
# Production:
# VITE_API_URL=https://api.retailcosmos.com
VITE_PUBLIC_SITE_URL=https://app.retailcosmos.com

# Tenant URL mode:
# auto (default) = path on app/localhost, subdomain on {slug}.retailcosmos.com
# path = always /your-store/...
# subdomain = always https://your-store.retailcosmos.com
VITE_ROOT_DOMAIN=retailcosmos.com
VITE_TENANT_BASE_DOMAIN=retailcosmos.com
VITE_TENANT_ROUTING=auto

# Netlify Edge (WhatsApp / social OG): set in Netlify site env, not Vite
# API_BASE_URL=https://api.retailcosmos.com
# TENANT_BASE_DOMAIN=retailcosmos.com
# ROOT_DOMAIN=retailcosmos.com

# Razorpay publishable key (same as RAZORPAY_KEY_ID on backend — never put KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=

# Sentry for the browser app — leave empty to disable (the SDK is then never downloaded).
# Use a separate Sentry project from the backend. The DSN is public by design.
VITE_SENTRY_DSN=
# Defaults to the Vite mode (production/development) when empty.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
