# Server-only proxy target (not exposed in the browser bundle).
# Used when VITE_API_URL is unset and the app calls relative /api.
API_PROXY_TARGET=http://127.0.0.1:8000

# Browser API base URL (read by src/constants/api.ts as VITE_API_URL).
# Local + proxy: leave unset so API_BASE_URL stays "/api"
# EC2 FastAPI (port 8000 required until nginx proxies /):
# VITE_API_URL=http://13.53.130.77:8000

# Tenant URL mode:
# auto (default) = path on Netlify/localhost, subdomain on *.retailcosmos.com
# path = always /shopsphere/...
# subdomain = always shopsphere.retailcosmos.com
VITE_ROOT_DOMAIN=retailcosmos.com
VITE_TENANT_ROUTING=auto

# Razorpay publishable key (same as RAZORPAY_KEY_ID on backend — never put KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=
